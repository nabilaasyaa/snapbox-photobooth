# Salin file ini menjadi ".env" (tanpa ".example") lalu isi nilainya.
# JANGAN commit file .env (yang sudah berisi key asli) ke Git/publik manapun.

# Dapatkan dari Resend dashboard → API Keys → Create API Key
RESEND_API_KEY=

# Alamat email pengirim.
# Untuk testing cepat, boleh pakai "onboarding@resend.dev" (sudah disediakan
# Resend, tidak perlu verifikasi domain). Untuk pakai email/domain sendiri,
# verifikasi dulu di Resend dashboard → Domains.
SENDER_EMAIL=onboarding@resend.dev

# Port lokal untuk server ini (boleh dibiarkan default)
PORT=4000
